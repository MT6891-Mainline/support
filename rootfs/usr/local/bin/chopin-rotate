#!/usr/bin/env python3
# Rotate DSI-1 from the accelerometer on chopin (MT6893), KDE/KWin backend.
import os,subprocess,time
IIO="/sys/bus/iio/devices/iio:device1"; OUT=os.environ.get("OUT","DSI-1")
MAP={"normal":"normal","right-up":"right","left-up":"left","bottom-up":"inverted"}
def rd(n):
    for _ in range(40):
        try: return open(IIO+"/"+n).read().strip()
        except (OSError,TypeError): time.sleep(.05)
    raise OSError(n)
def rot():
    x,y,z=(int(rd("in_accel_%s_raw"%c))*float(rd("in_accel_scale")) for c in "xyz")
    if abs(z)>7: return "flat"
    if abs(y)>1.6*abs(x): return "normal" if y>0 else "bottom-up"
    if abs(x)>1.6*abs(y): return "right-up" if x>0 else "left-up"
    return "unclear"
def env():
    e=dict(os.environ); e.setdefault("XDG_RUNTIME_DIR","/run/user/%d"%os.getuid())
    e.setdefault("QT_QPA_PLATFORM","wayland")
    if "WAYLAND_DISPLAY" not in e:
        try:
            for f in sorted(os.listdir(e["XDG_RUNTIME_DIR"])):
                if f.startswith("wayland-"): e["WAYLAND_DISPLAY"]=f; break
        except OSError: pass
    return e
def rot():
    x,y,z=(int(rd("in_accel_%s_raw"%c))*float(rd("in_accel_scale")) for c in "xyz")
    if abs(z)>7: return "flat"
    if abs(y)>1.6*abs(x): return "normal" if y>0 else "bottom-up"
    if abs(x)>1.6*abs(y): return "right-up" if x>0 else "left-up"
    return "unclear"
def env():
    e=dict(os.environ); e.setdefault("XDG_RUNTIME_DIR","/run/user/%d"%os.getuid())
    e.setdefault("QT_QPA_PLATFORM","wayland")
    if "WAYLAND_DISPLAY" not in e:
        try:
            for f in sorted(os.listdir(e["XDG_RUNTIME_DIR"])):
                if f.startswith("wayland-"): e["WAYLAND_DISPLAY"]=f; break
        except OSError: pass
    return e
last=None; pend=None; n=0
while True:
    try:
        o=rot()
    except (OSError,TypeError):
        time.sleep(1); continue
    if o in ("flat","unclear"): pend=None; n=0; time.sleep(.2); continue
    if o==pend: n+=1
    else: pend=o; n=1
    if n>=3 and o!=last:
        r=subprocess.run(["kscreen-doctor","output.%s.rotation.%s"%(OUT,MAP[o])],env=env(),capture_output=True,text=True)
        print(("rotate %s -> %s"%(o,MAP[o])) if r.returncode==0 else ("FAILED: "+r.stderr.strip()[:200]),flush=True)
        last=o
    time.sleep(.2)
