#!/usr/bin/env python3
"""chopin: turn the power button into a screen on/off toggle.

The PMIC interrupt line used to be pointed at the GIC instead of the pinctrl
EINT, so the whole PMIC interrupt domain was dead and the power button produced
no input events at all.  With that fixed (see mt6893-xiaomi-chopin-ovl-pmic.dtsi)
the button reports KEY_POWER again; toggle the backlight on it.

GNOME's own power-button-action is set to 'nothing', because the only thing it
could do on this board is suspend, which is unusable here.

GNOME's power-button-action can only suspend, hibernate, power off or do nothing,
and suspend is unusable on this board (it leaves the panel garbled), so the button
currently does nothing at all - gnome-settings-daemon grabs the key, tries to
suspend, and the suspend inhibitor we install blocks it.

Read the PMIC key device directly and toggle the backlight instead.  Doing it
through the backlight (rather than a DRM blank) also avoids touching the DSI and
panel state machines, which is where the suspend garbling comes from: the panel
keeps scanning out and only the light goes off, so waking is instant and safe.
The normal 60 s idle blank still does the full DPMS off for real power saving.
"""
import os
import re
import select
import struct
import subprocess
import sys

EV_KEY = 1
KEY_POWER = 116
UID = 1000
SAVE = "/run/chopin-powerkey-brightness"
BACKLIGHT = "/sys/class/backlight"


def find_key_device(code):
    """Return the /dev/input/eventN node that reports @code."""
    for entry in sorted(os.listdir("/sys/class/input")):
        if not entry.startswith("event"):
            continue
        try:
            with open("/sys/class/input/%s/device/capabilities/key" % entry) as f:
                words = f.read().split()
        except OSError:
            continue
        value = 0
        for i, word in enumerate(reversed(words)):
            value |= int(word, 16) << (i * 64)
        if (value >> code) & 1:
            return "/dev/input/" + entry
    return None


def backlight_path():
    for name in sorted(os.listdir(BACKLIGHT)):
        return os.path.join(BACKLIGHT, name, "brightness")
    return None


def read_int(path):
    try:
        with open(path) as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return None


def write_int(path, value):
    try:
        with open(path, "w") as f:
            f.write(str(value))
        return True
    except OSError as err:
        print("chopin-powerkey: %s: %s" % (path, err), file=sys.stderr)
        return False


def toggle(bl):
    current = read_int(bl)
    if not current:
        # screen is dark: restore the brightness saved on the way down
        saved = read_int(SAVE) or read_int(os.path.join(os.path.dirname(bl),
                                                        "max_brightness")) // 2
        print("chopin-powerkey: on (%d)" % saved, flush=True)
        write_int(bl, saved)
    else:
        write_int(SAVE, current)
        print("chopin-powerkey: off (saved %d)" % current, flush=True)
        write_int(bl, 0)


def main():
    dev = find_key_device(KEY_POWER)
    bl = backlight_path()
    if not dev or not bl:
        print("chopin-powerkey: no key device or no backlight", file=sys.stderr)
        return 1

    print("chopin-powerkey: %s -> %s (power key)" % (dev, bl), flush=True)
    fd = os.open(dev, os.O_RDONLY)
    fmt = "llHHi"
    size = struct.calcsize(fmt)

    while True:
        ready, _, _ = select.select([fd], [], [], 60)
        if not ready:
            continue
        data = os.read(fd, size * 16)
        for off in range(0, len(data) - size + 1, size):
            _, _, etype, code, value = struct.unpack(fmt, data[off:off + size])
            # value 1 = press; leave release and autorepeat alone
            if etype == EV_KEY and code == KEY_POWER and value == 1:
                toggle(bl)


if __name__ == "__main__":
    sys.exit(main())
