# chopin: GNOME system defaults.
#
# idling: blanking has been safe since the DSI underrun recovery learned to retry
# until the panel is really back (v143), and it is where the idle power saving
# comes from - there is no working suspend on this board, so the screen is the
# only thing that can be turned off.
[org/gnome/desktop/session]
idle-delay=uint32 60

# never lock: the panel comes back from a blank without a lock screen so a touch
# is enough to wake it.
[org/gnome/desktop/screensaver]
lock-enabled=false

[org/gnome/settings-daemon/plugins/power]
# No idle suspend: suspend is unusable here (see chopin-docs/power/).
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-type='nothing'
# The power button is handled by chopin-powerkey, which toggles the backlight
# directly.  gsd must not act on it: its only options are suspend/hibernate/power
# off/interactive, and suspend is blocked, which used to pop up an end-session
# dialog instead.
power-button-action='nothing'

# Chinese input: keep English as the first source and libpinyin second, so
# Super+Space (the default switch-input-source binding) toggles between them.
# Needs ibus-libpinyin installed; GNOME starts ibus automatically once an ibus
# source is configured.
[org/gnome/desktop/input-sources]
sources=[('xkb', 'us'), ('ibus', 'libpinyin')]
