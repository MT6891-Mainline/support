[Desktop Entry]
Type=Application
Name=Chopin auto-rotate
Comment=Rotate the panel from the accelerometer (chopin / MT6893)
# Started by Plasma at login, so it inherits the session environment that
# kscreen-doctor needs (XDG_RUNTIME_DIR, WAYLAND_DISPLAY, QT_QPA_PLATFORM).
Exec=/usr/bin/chopin-autorotate
X-KDE-autostart-after=panel
X-GNOME-Autostart-enabled=true
NoDisplay=true
